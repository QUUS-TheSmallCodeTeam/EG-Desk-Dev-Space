{
  "set": "work-placement-predicates-v3",
  "tokenCeiling": 5000,
  "passRule": "A request passes when every hard check holds: an expected yes has probability >= 0.8 (the product's bar for acting on a yes) and an expected no has probability <= 0.799. The set passes when all 6 requests pass. Near misses (same company or same kind of document, another matter) are soft: a miss is reported, never a failure. The note of every check starts with its kind.",
  "requests": [
    {
      "id": "pl-same-matter-quote",
      "file": "requests/pl-same-matter-quote.json",
      "sha256": "9d9b797131fc18137306931eccb22f04c396b62d974cc11cd95b7315eafc6a6c",
      "estInputTokens": 722,
      "expect": [
        {
          "name": "same_matter_R1",
          "kind": "predicate",
          "min": 0.8,
          "severity": "hard",
          "note": "yes: the earlier version of the same quote"
        },
        {
          "name": "same_matter_R2",
          "kind": "predicate",
          "max": 0.799,
          "severity": "hard",
          "note": "no: another matter altogether"
        },
        {
          "name": "same_matter_R3",
          "kind": "predicate",
          "max": 0.799,
          "severity": "soft",
          "note": "near_miss: another client's document"
        }
      ]
    },
    {
      "id": "pl-same-matter-report",
      "file": "requests/pl-same-matter-report.json",
      "sha256": "564fdbf3e48da570b32ae27066023089974ae08c84a9c403333cb015afa25e75",
      "estInputTokens": 719,
      "expect": [
        {
          "name": "same_matter_R1",
          "kind": "predicate",
          "max": 0.799,
          "severity": "soft",
          "note": "near_miss: same company, another matter"
        },
        {
          "name": "same_matter_R2",
          "kind": "predicate",
          "min": 0.8,
          "severity": "hard",
          "note": "yes: the figures for that report"
        },
        {
          "name": "same_matter_R3",
          "kind": "predicate",
          "max": 0.799,
          "severity": "soft",
          "note": "near_miss: the same kind of report, another company"
        }
      ]
    },
    {
