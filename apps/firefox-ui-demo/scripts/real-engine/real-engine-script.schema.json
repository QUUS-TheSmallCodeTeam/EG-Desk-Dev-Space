{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "egdesk/real-engine-script.schema.json",
  "title": "EG-Desk real-engine check conversation script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "set",
    "conversations"
  ],
  "properties": {
    "set": {
      "type": "string",
      "pattern": "^real-engine-[a-z0-9][a-z0-9-]{0,40}-v\\d{1,3}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "turns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "folder": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "maxLength": 200
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "flags": {
            "type": "object",
            "propertyNames": {
              "pattern": "^EGDESK_[A-Z0-9_]{1,48}$",
              "not": {
                "enum": [
                  "EGDESK_CODEX_BIN",
                  "EGDESK_DATA_DIR",
                  "EGDESK_CODEX_MODEL",
                  "EGDESK_CODEX_EFFORT",
                  "EGDESK_CODEX_DISABLE_MEMORIES",
                  "EGDESK_CLAUDE_BIN"
                ]
              }
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,24}$"
            }
          },
          "turns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "say"
                  ]
                },
                {
                  "required": [
                    "action"
                  ]
                }
              ],
              "properties": {
                "say": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "action": {
                  "enum": [
                    "interrupt",
                    "steer",
                    "delete"
                  ]
                },
                "afterMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120000
                },
                "approve": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "enum": [
                      "yes",
                      "no"
                    ]
                  }
                },
                "whileRunning": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "afterMs"
                  ],
                  "properties": {
                    "afterMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 120000
                    }
                  }
                },
                "expect": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "toolCalls": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      }
                    },
                    "noToolCalls": {
                      "const": true
                    },
                    "posted": {
                      "type": "boolean"
                    },
                    "answerIncludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "answerExcludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "noNativeTools": {
                      "const": true
                    },
                    "asked": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "commandsRan": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "commandsRanIncludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "commandsRanExcludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "files": {
                      "type": "object",
                      "maxProperties": 32,
                      "additionalProperties": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 65536
                      }
                    },
                    "undoRecords": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 50
                    },
                    "turnStatus": {
                      "enum": [
                        "completed",
                        "failed",
                        "interrupted"
                      ]
                    },
                    "compacted": {
                      "type": "boolean"
                    },
                    "conversationGone": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
