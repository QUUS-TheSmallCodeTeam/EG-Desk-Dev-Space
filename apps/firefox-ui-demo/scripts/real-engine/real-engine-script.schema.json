{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "egdesk/real-engine-script.schema.json",
  "title": "EG-Desk real-engine check conversation script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "set",
    "conversations"
  ],
  "properties": {
    "set": {
      "type": "string",
      "pattern": "^real-engine-[a-z0-9][a-z0-9-]{0,40}-v\\d{1,3}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "turns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "draftCheck": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "advisory",
                  "on"
                ]
              },
              "design": {
                "enum": [
                  "predicates",
                  "choice"
                ]
              }
            }
          },
          "agentProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "instructions"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "tone": {
                "enum": [
                  "plain",
                  "warm",
                  "concise",
                  "formal",
                  "playful"
                ]
              },
              "expertise": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          },
          "folder": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "maxLength": 200
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "flags": {
            "type": "object",
            "propertyNames": {
              "pattern": "^EGDESK_[A-Z0-9_]{1,48}$",
              "not": {
                "enum": [
                  "EGDESK_CODEX_BIN",
                  "EGDESK_DATA_DIR",
                  "EGDESK_CODEX_MODEL",
                  "EGDESK_CODEX_EFFORT",
                  "EGDESK_CODEX_DISABLE_MEMORIES",
                  "EGDESK_CLAUDE_BIN"
                ]
              }
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,24}$"
            }
          },
          "memory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pages"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "on",
                  "advisory"
                ]
              },
              "pages": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "body"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9/_-]{0,59}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "time": {
                      "enum": [
                        "past",
                        "present",
                        "planned",
                        "hypothetical"
                      ]
                    },
                    "status": {
                      "enum": [
                        "done",
                        "plan"
                      ]
                    },
                    "links": {
                      "type": "array",
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "to"
                        ],
                        "properties": {
                          "to": {
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "follows_from",
                              "refers_to",
                              "same_task"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "speechConsent": {
            "type": "boolean"
          },
          "seededWrites": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "pages": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "scope"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,59}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    "scope": {
                      "enum": [
                        "conversation",
                        "other",
                        "personal"
                      ]
                    },
                    "pointer": {
                      "const": true
                    }
                  }
                }
              },
              "readings": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "page",
                    "state"
                  ],
                  "properties": {
                    "page": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,59}$"
                    },
                    "state": {
                      "enum": [
                        "pending",
                        "accepted"
                      ]
                    },
                    "from": {
                      "enum": [
                        "conversation",
                        "other"
                      ]
                    }
                  }
                }
              }
            }
          },
          "turns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "say"
                  ]
                },
                {
                  "required": [
                    "action"
                  ]
                }
              ],
              "properties": {
                "say": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "from": {
                  "enum": [
                    "owner",
                    "invited"
                  ]
                },
                "alongside": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "say"
                  ],
                  "properties": {
                    "say": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "from": {
                      "enum": [
                        "owner",
                        "invited"
                      ]
                    }
                  }
                },
                "browserTask": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "done",
                        "cannot_proceed",
                        "need_context"
                      ]
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "candidates": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "pageText": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "identifiers": {
                      "type": "array",
                      "maxItems": 4,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "steps": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 12
                    },
                    "actions": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "fill": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 12
                        },
                        "navigate": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 12
                        },
                        "scroll": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 12
                        }
                      }
                    }
                  }
                },
                "action": {
                  "enum": [
                    "interrupt",
                    "steer",
                    "delete",
                    "restart"
                  ]
                },
                "afterMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120000
                },
                "approve": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "enum": [
                      "yes",
                      "no"
                    ]
                  }
                },
                "whileRunning": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "afterMs"
                  ],
                  "properties": {
                    "afterMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 120000
                    }
                  }
                },
                "expect": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "toolCalls": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      }
                    },
                    "noToolCalls": {
                      "const": true
                    },
                    "posted": {
                      "type": "boolean"
                    },
                    "answerIncludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "answerExcludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "noNativeTools": {
                      "const": true
                    },
                    "asked": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "commandsRan": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "commandsRanIncludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "commandsRanExcludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "files": {
                      "type": "object",
                      "maxProperties": 32,
                      "additionalProperties": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 65536
                      }
                    },
                    "undoRecords": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 50
                    },
                    "turnStatus": {
                      "enum": [
                        "completed",
                        "failed",
                        "interrupted"
                      ]
                    },
                    "compacted": {
                      "type": "boolean"
                    },
                    "conversationGone": {
                      "type": "boolean"
                    },
                    "draftCheck": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ran"
                      ],
                      "properties": {
                        "ran": {
                          "type": "boolean"
                        },
                        "rejects": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        }
                      }
                    },
                    "resumes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "postedMin": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "unsubscribes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "collab": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "requester": {
                          "enum": [
                            "owner",
                            "invited"
                          ]
                        },
                        "attention": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "branch": {
                              "enum": [
                                "owner",
                                "requester"
                              ]
                            },
                            "kind": {
                              "enum": [
                                "leave",
                                "point",
                                "surface_near_requester"
                              ]
                            },
                            "pointer": {
                              "enum": [
                                "posted",
                                "raised",
                                "none"
                              ]
                            }
                          }
                        },
                        "ownerQuestion": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "questions": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 4,
                              "items": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_]{0,40}$"
                              }
                            },
                            "quotesRequest": {
                              "type": "array",
                              "maxItems": 8,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                              }
                            },
                            "quotesOwnAnswer": {
                              "const": true
                            }
                          }
                        },
                        "noIdentity": {
                          "const": true
                        },
                        "cameraUntouched": {
                          "const": true
                        },
                        "roomKept": {
                          "const": true
                        },
                        "receiptsClosed": {
                          "const": true
                        },
                        "continuity": {
                          "const": true
                        },
                        "twoRuns": {
                          "const": true
                        }
                      }
                    },
                    "memory": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "attached": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 12,
                          "items": {
                            "type": "string"
                          }
                        },
                        "notAttached": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 12,
                          "items": {
                            "type": "string"
                          }
                        },
                        "noResends": {
                          "const": true
                        },
                        "noDuplicates": {
                          "const": true
                        },
                        "minKeyChars": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 200000
                        },
                        "merged": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 12
                        },
                        "maxKeyChars": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 200000
                        },
                        "maxKeyBytes": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 800000
                        }
                      }
                    },
                    "recording": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "page"
                      ],
                      "properties": {
                        "page": {
                          "type": "string"
                        },
                        "reading": {
                          "enum": [
                            "none",
                            "pending",
                            "accepted",
                            "rejected",
                            "pending_or_none"
                          ]
                        },
                        "status": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 8,
                          "items": {
                            "enum": [
                              "plan",
                              "done",
                              "superseded"
                            ]
                          }
                        },
                        "basis": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 8,
                          "items": {
                            "enum": [
                              "self_reported_observation",
                              "attributed_report",
                              "inference",
                              "record_based",
                              "unspecified",
                              null
                            ]
                          }
                        },
                        "pageStatus": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 8,
                          "items": {
                            "enum": [
                              "unknown",
                              "plan",
                              "done"
                            ]
                          }
                        },
                        "confirmed": {
                          "type": "boolean"
                        },
                        "readings": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 20
                        },
                        "newPages": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 20
                        }
                      }
                    },
                    "engine": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "steers": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "interrupts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "steerCarries": {
                          "const": true
                        },
                        "flowMessages": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "equals": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            },
                            "max": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            },
                            "min": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            }
                          }
                        },
                        "agentMessages": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "equals": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            },
                            "max": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            },
                            "min": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            }
                          }
                        },
                        "commandStopped": {
                          "const": true
                        },
                        "maxLatencyMs": {
                          "type": "integer",
                          "minimum": 1000,
                          "maximum": 3600000
                        }
                      }
                    },
                    "rewrite": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "answered": {
                          "type": "boolean"
                        },
                        "finding": {
                          "type": "boolean"
                        },
                        "rewrote": {
                          "type": "boolean"
                        },
                        "posted": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "uniqueItems": true,
                          "items": {
                            "enum": [
                              "as_written",
                              "revised",
                              "certain_part",
                              "withheld"
                            ]
                          }
                        },
                        "neverShown": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "numbers": {
                              "const": true
                            },
                            "phrases": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 8,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 40
                              }
                            }
                          }
                        }
                      }
                    },
                    "briefing": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "outcome": {
                          "enum": [
                            "presented",
                            "fallback-chat",
                            "bubble"
                          ]
                        },
                        "reason": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,40}$"
                        },
                        "schemaSent": {
                          "type": "boolean"
                        },
                        "schemaInvalid": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 20
                        },
                        "factsOnBoard": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 400
                          }
                        },
                        "factsInCards": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 400
                          }
                        },
                        "inOrder": {
                          "type": "array",
                          "maxItems": 4,
                          "items": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 16,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 400
                            }
                          }
                        }
                      }
                    },
                    "browserAnswer": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "mentionsDates": {
                          "type": "array",
                          "maxItems": 4,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 10,
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        },
                        "noInventedDates": {
                          "const": true
                        },
                        "noInventedAmounts": {
                          "const": true
                        },
                        "namesAnyOf": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          }
                        },
                        "namesAllOf": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          }
                        }
                      }
                    },
                    "deleted": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "routeAccepted": {
                          "const": true
                        },
                        "storeRowsGone": {
                          "const": true
                        },
                        "engineGone": {
                          "const": true
                        },
                        "pendingReadingsWithdrawn": {
                          "const": true
                        },
                        "conversationMemoryGone": {
                          "const": true
                        },
                        "otherMemoryKept": {
                          "const": true
                        },
                        "pointerMarked": {
                          "const": true
                        }
                      }
                    },
                    "coding": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "changed": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        },
                        "lastTests": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "health": {
                              "enum": [
                                "healthy",
                                "unhealthy",
                                "unknown"
                              ]
                            },
                            "failed": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "minFailed": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "minPassed": {
                              "type": "integer",
