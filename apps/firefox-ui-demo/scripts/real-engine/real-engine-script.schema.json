{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "egdesk/real-engine-script.schema.json",
  "title": "EG-Desk real-engine check conversation script",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "set",
    "conversations"
  ],
  "properties": {
    "set": {
      "type": "string",
      "pattern": "^real-engine-[a-z0-9][a-z0-9-]{0,40}-v\\d{1,3}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "conversations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "turns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "draftCheck": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "advisory",
                  "on"
                ]
              },
              "design": {
                "enum": [
                  "predicates",
                  "choice"
                ]
              }
            }
          },
          "agentProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "instructions"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "tone": {
                "enum": [
                  "plain",
                  "warm",
                  "concise",
                  "formal",
                  "playful"
                ]
              },
              "expertise": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          },
          "folder": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "maxLength": 200
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "flags": {
            "type": "object",
            "propertyNames": {
              "pattern": "^EGDESK_[A-Z0-9_]{1,48}$",
              "not": {
                "enum": [
                  "EGDESK_CODEX_BIN",
                  "EGDESK_DATA_DIR",
                  "EGDESK_CODEX_MODEL",
                  "EGDESK_CODEX_EFFORT",
                  "EGDESK_CODEX_DISABLE_MEMORIES",
                  "EGDESK_CLAUDE_BIN"
                ]
              }
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,24}$"
            }
          },
          "memory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pages"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "on",
                  "advisory"
                ]
              },
              "pages": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "body"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9/_-]{0,59}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "body": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    },
                    "time": {
                      "enum": [
                        "past",
                        "present",
                        "planned",
                        "hypothetical"
                      ]
                    },
                    "status": {
                      "enum": [
                        "done",
                        "plan"
                      ]
                    },
                    "links": {
                      "type": "array",
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "to"
                        ],
                        "properties": {
                          "to": {
                            "type": "string"
                          },
                          "type": {
                            "enum": [
                              "follows_from",
                              "refers_to",
                              "same_task"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "turns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "say"
                  ]
                },
                {
                  "required": [
                    "action"
                  ]
                }
              ],
              "properties": {
                "say": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "action": {
                  "enum": [
                    "interrupt",
                    "steer",
                    "delete"
                  ]
                },
                "afterMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 120000
                },
                "approve": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "enum": [
                      "yes",
                      "no"
                    ]
                  }
                },
                "whileRunning": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "afterMs"
                  ],
                  "properties": {
                    "afterMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 120000
                    }
                  }
                },
                "expect": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "toolCalls": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      }
                    },
                    "noToolCalls": {
                      "const": true
                    },
                    "posted": {
                      "type": "boolean"
                    },
                    "answerIncludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "answerExcludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "noNativeTools": {
                      "const": true
                    },
                    "asked": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "commandsRan": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    },
                    "commandsRanIncludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "commandsRanExcludes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      }
                    },
                    "files": {
                      "type": "object",
                      "maxProperties": 32,
                      "additionalProperties": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 65536
                      }
                    },
                    "undoRecords": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 50
                    },
                    "turnStatus": {
                      "enum": [
                        "completed",
                        "failed",
                        "interrupted"
                      ]
                    },
                    "compacted": {
                      "type": "boolean"
                    },
                    "conversationGone": {
                      "type": "boolean"
                    },
                    "draftCheck": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ran"
                      ],
                      "properties": {
                        "ran": {
                          "type": "boolean"
                        },
                        "rejects": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 50
                        }
                      }
                    },
                    "resumes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "postedMin": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 20
                    },
                    "unsubscribes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 20
                    },
                    "memory": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "attached": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 12,
                          "items": {
                            "type": "string"
                          }
                        },
                        "notAttached": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 12,
                          "items": {
                            "type": "string"
                          }
                        },
                        "noResends": {
                          "const": true
                        },
                        "noDuplicates": {
                          "const": true
                        },
                        "minKeyChars": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 200000
                        },
                        "merged": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 12
                        }
                      }
                    },
                    "engine": {
                      "type": "object",
                      "additionalProperties": false,
                      "minProperties": 1,
                      "properties": {
                        "steers": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "interrupts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        },
                        "steerCarries": {
                          "const": true
                        },
                        "flowMessages": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "equals": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            },
                            "max": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            },
                            "min": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            }
                          }
                        },
                        "agentMessages": {
                          "type": "object",
                          "additionalProperties": false,
                          "minProperties": 1,
                          "properties": {
                            "equals": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            },
                            "max": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            },
                            "min": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 20
                            }
                          }
                        },
                        "commandStopped": {
                          "const": true
                        },
                        "maxLatencyMs": {
                          "type": "integer",
                          "minimum": 1000,
                          "maximum": 3600000
                        }
                      }
                    },
                    "briefing": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "outcome": {
                          "enum": [
                            "presented",
                            "fallback-chat",
                            "bubble"
                          ]
                        },
                        "reason": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,40}$"
                        },
                        "schemaSent": {
                          "type": "boolean"
                        },
                        "schemaInvalid": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0,
                          "maximum": 20
                        },
                        "factsOnBoard": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 400
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
