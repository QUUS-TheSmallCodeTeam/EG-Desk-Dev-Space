{
  "set": "real-engine-browser-loop-v1",
  "description": "The person's message goes through the product's turn-start entry (judged by the real Decision model), the product's objective loop runs on recorded fixture page states (no Firefox, no network), and the closed note goes into the same engine turn: the real reply is checked by code. Needs --decisions.",
  "conversations": [
    {
      "id": "loop-membership",
      "folder": {
        "README.txt": "scratch"
      },
      "flags": {
        "EGDESK_BROWSER_LOOP": "on"
      },
      "turns": [
        {
          "say": "다음 결제일이 언제야?",
          "browserLoop": {
            "pages": "membership",
            "host": "streamly.example.test",
            "start": "/account/membership",
            "title": "멤버십 관리 | 스트리밍플러스"
          },
          "expect": {
            "turnStatus": "completed",
            "posted": true,
            "browserLoop": {
              "entered": true,
              "noActs": true,
              "noteStatus": "done",
              "noteIncludes": [
                "다음 결제일: 2026-12-14"
              ],
              "mentionsDates": [
                "2026-12-14"
              ],
              "noInventedDates": true,
              "noInventedAmounts": true
            }
          }
        }
      ]
    },
    {
      "id": "loop-delivery",
      "folder": {
        "README.txt": "scratch"
      },
      "flags": {
        "EGDESK_BROWSER_LOOP": "on"
