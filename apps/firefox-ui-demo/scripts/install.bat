@echo off
setlocal enabledelayedexpansion

REM ==============================================================
REM  EG-Desk firefox-ui-demo - Windows installer
REM ==============================================================

echo.
echo === EG-Desk firefox-ui-demo installer ===
echo.

REM --- admin check ---
net session >nul 2>&1
if errorlevel 1 goto :err_admin

REM --- paths ---
set "REPO_ROOT=%~dp0.."
set "OVERLAY_DIR=%REPO_ROOT%\overlay"
set "TMP_CLONE=%TEMP%\egdesk-fx-autoconfig"

REM --- detect Firefox install (avoid if/else parens bug with x86 path) ---
set "FF_INSTALL="
if exist "C:\Program Files\Mozilla Firefox\firefox.exe" set "FF_INSTALL=C:\Program Files\Mozilla Firefox"
if not defined FF_INSTALL if exist "C:\Program Files (x86)\Mozilla Firefox\firefox.exe" set "FF_INSTALL=C:\Program Files (x86)\Mozilla Firefox"
if not defined FF_INSTALL goto :err_noffinstall
echo [info] Firefox install: !FF_INSTALL!

REM --- detect profile ---
set "FF_PROFILES=%APPDATA%\Mozilla\Firefox\Profiles"
if not exist "%FF_PROFILES%" goto :err_noprofilesdir

set "FF_PROFILE="
for /d %%D in ("%FF_PROFILES%\*.default-release") do set "FF_PROFILE=%%D"
if not defined FF_PROFILE (
  for /d %%D in ("%FF_PROFILES%\*.default") do set "FF_PROFILE=%%D"
)
if not defined FF_PROFILE goto :err_noprofile
echo [info] Firefox profile: !FF_PROFILE!

REM --- git check ---
where git >nul 2>&1
if errorlevel 1 goto :err_nogit

REM --- clone ---
if exist "%TMP_CLONE%" rmdir /s /q "%TMP_CLONE%"
echo [step] Cloning MrOtherGuy/fx-autoconfig ...
git clone --depth=1 https://github.com/MrOtherGuy/fx-autoconfig.git "%TMP_CLONE%"
if errorlevel 1 goto :err_clone

REM --- copy bootstrap to Firefox install dir ---
echo [step] Installing bootstrap into Firefox install dir ...
copy /y "%TMP_CLONE%\program\config.js" "!FF_INSTALL!\" >nul
if errorlevel 1 goto :err_copy
if not exist "!FF_INSTALL!\defaults\pref" mkdir "!FF_INSTALL!\defaults\pref"
copy /y "%TMP_CLONE%\program\defaults\pref\config-prefs.js" "!FF_INSTALL!\defaults\pref\" >nul

REM --- copy loader + overlay to profile chrome ---
echo [step] Installing loader into profile chrome ...
if not exist "!FF_PROFILE!\chrome" mkdir "!FF_PROFILE!\chrome"
xcopy /e /i /y "%TMP_CLONE%\profile\chrome\utils" "!FF_PROFILE!\chrome\utils" >nul
if not exist "!FF_PROFILE!\chrome\JS" mkdir "!FF_PROFILE!\chrome\JS"
if not exist "!FF_PROFILE!\chrome\CSS" mkdir "!FF_PROFILE!\chrome\CSS"
if not exist "!FF_PROFILE!\chrome\resources" mkdir "!FF_PROFILE!\chrome\resources"

echo [step] Copying EG-Desk overlay ...
copy /y "%OVERLAY_DIR%\JS\*.uc.js" "!FF_PROFILE!\chrome\JS\" >nul
copy /y "%OVERLAY_DIR%\CSS\*.uc.css" "!FF_PROFILE!\chrome\CSS\" >nul
xcopy /e /i /y "%OVERLAY_DIR%\resources" "!FF_PROFILE!\chrome\resources" >nul

REM --- build userChrome.css ---
set "USERCHROME=!FF_PROFILE!\chrome\userChrome.css"
echo /* Auto-generated by EG-Desk installer */ > "!USERCHROME!"
for %%F in ("!FF_PROFILE!\chrome\CSS\*.uc.css") do (
  echo @import url("CSS/%%~nxF"); >> "!USERCHROME!"
)

if exist "%TMP_CLONE%" rmdir /s /q "%TMP_CLONE%" >nul 2>&1

echo.
echo === Install complete ===
echo.
echo Next steps:
echo   1. about:config - toolkit.legacyUserProfileCustomizations.stylesheets = true
echo   2. about:support - Clear startup cache... button
echo   3. Restart Firefox
echo.
echo Uninstall: scripts\uninstall.bat
endlocal
exit /b 0

:err_admin
echo [ERROR] Administrator privileges required.
endlocal
exit /b 1

:err_noffinstall
echo [ERROR] Firefox install dir not found.
endlocal
exit /b 2

:err_noprofilesdir
echo [ERROR] Profiles dir not found: %FF_PROFILES%
endlocal
exit /b 3

:err_noprofile
echo [ERROR] default-release or default profile not found.
endlocal
exit /b 4

:err_nogit
echo [ERROR] git not found in PATH.
endlocal
exit /b 5

:err_clone
echo [ERROR] fx-autoconfig clone failed. Check network.
endlocal
exit /b 6

:err_copy
echo [ERROR] Failed to copy bootstrap files (permission issue?).
endlocal
exit /b 7
