{
  "name": "eg-desk",
  "version": "0.1.0",
  "description": "EG-Desk — Ambient AI workspace",
  "main": "./dist-electron/main/index.js",
  "author": "EG-Desk Team",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs --no-electron",
    "dev:full": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "tsc -p tsconfig.node.json --watch --preserveWatchOutput --pretty false",
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.2",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
